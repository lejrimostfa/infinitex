{
  "name": "infinitex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Procedural three.js TSL materials whose detail grows as the camera zooms in.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./kit": "./src/kit.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "infinitex-check": "bin/infinitex-check.mjs",
    "infinitex-new-family": "bin/infinitex-new-family.mjs"
  },
  "scripts": {
    "dev": "vite --port 5211 --strictPort",
    "build": "vite build",
    "gate": "node tests/run-gate.mjs",
    "new-family": "node bin/infinitex-new-family.mjs",
    "check-family": "node bin/infinitex-check.mjs",
    "test-kit": "node tests/kit_volume.mjs && node tests/kit_lint.mjs"
  },
  "peerDependencies": {
    "three": ">=0.187.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "three": "0.187.0",
    "three-mesh-bvh": "^0.9.18",
    "vite": "8.3.5"
  },
  "license": "MIT"
}
